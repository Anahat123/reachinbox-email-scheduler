{
  "name": "reachinbox-scheduler-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Email scheduler API + BullMQ worker",
  "scripts": {
    "dev": "concurrently -n api,worker -c blue,magenta \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "concurrently -n api,worker \"npm:start:api\" \"npm:start:worker\"",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "dev-token": "tsx scripts/dev-token.ts",
    "load-test": "tsx scripts/load-test.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@bull-board/api": "6.21.3",
    "@bull-board/express": "6.21.3",
    "@elastic/elasticsearch": "8.19.2",
    "@prisma/client": "6.19.3",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.22.3",
    "google-auth-library": "9.15.1",
    "helmet": "8.0.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.2",
    "nodemailer": "6.9.16",
    "pino": "9.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.5",
    "@types/nodemailer": "6.4.17",
    "concurrently": "9.1.2",
    "pino-pretty": "13.0.0",
    "prisma": "6.19.3",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  }
}

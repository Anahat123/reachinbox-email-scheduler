# ---- Server ----
PORT=4000
# Where the Next.js dashboard runs (used for CORS + post-login redirects)
FRONTEND_URL=http://localhost:3000
# Public URL of this API (used to build OAuth redirect URIs if not set explicitly)
BACKEND_URL=http://localhost:4000
JWT_SECRET=change-me-to-a-long-random-string

# ---- Infra (matches docker-compose.yml) ----
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# ---- Google OAuth (https://console.cloud.google.com/apis/credentials) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ---- Slack OAuth (https://api.slack.com/apps) ----
# Slack requires an https redirect: run `ngrok http 4000` and paste that URL here.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://YOUR-SUBDOMAIN.ngrok-free.app/api/slack/callback

# ---- Ethereal senders ----
# If the DB has fewer senders than this, the API creates Ethereal test accounts on boot.
ETHEREAL_SENDER_COUNT=3

# ---- Throughput / rate limiting ----
# Parallel jobs per worker process
WORKER_CONCURRENCY=5
# Minimum gap between any two sends (BullMQ limiter, shared across all workers)
MIN_DELAY_BETWEEN_SENDS_MS=2000
# Hard cap per sender per clock hour (Redis counter, shared across all workers)
MAX_EMAILS_PER_HOUR_PER_SENDER=50
# Retries for transient SMTP errors before an email is marked failed
SEND_MAX_ATTEMPTS=3

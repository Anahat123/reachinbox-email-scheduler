generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  googleId  String   @unique
  email     String   @unique
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())

  campaigns Campaign[]
  emails    Email[]
  slack     SlackIntegration?
}

/// An SMTP identity emails are sent from (Ethereal test accounts in this project).
model Sender {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  smtpHost  String
  smtpPort  Int
  smtpUser  String
  smtpPass  String
  createdAt DateTime @default(now())

  campaigns Campaign[]
  emails    Email[]
}

/// One "Compose New Email" submission: a subject/body sent to many recipients.
model Campaign {
  id             String   @id @default(cuid())
  userId         String
  senderId       String
  subject        String
  body           String   @db.Text
  startAt        DateTime
  delayMs        Int
  hourlyLimit    Int
  idempotencyKey String?
  createdAt      DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender Sender  @relation(fields: [senderId], references: [id])
  emails Email[]

  @@unique([userId, idempotencyKey])
}

enum EmailStatus {
  scheduled
  sending
  sent
  failed
}

/// One recipient of a campaign. Its id doubles as the BullMQ jobId, which is
/// what makes enqueueing idempotent.
model Email {
  id            String      @id @default(cuid())
  campaignId    String
  userId        String
  senderId      String
  recipient     String
  position      Int
  scheduledAt   DateTime
  status        EmailStatus @default(scheduled)
  sentAt        DateTime?
  messageId     String?
  previewUrl    String?
  error         String?
  attempts      Int         @default(0)
  deferredCount Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender   Sender   @relation(fields: [senderId], references: [id])

  @@unique([campaignId, recipient])
  @@index([userId, status, scheduledAt])
  @@index([status, scheduledAt])
}

model SlackIntegration {
  id          String   @id @default(cuid())
  userId      String   @unique
  teamId      String
  teamName    String
  channel     String
  webhookUrl  String
  accessToken String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
